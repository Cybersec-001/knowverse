PORT=4000
DATABASE_URL=postgres://knowverse:knowverse@localhost:5432/knowverse
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:3000
# Mock generates deterministic sample data, not real AI output. Gemini can transcribe supported uploaded videos with its Files API and 2.5 Flash, subject to free-tier quotas.
AI_PROVIDER=mock
# Gemini 2.5 Flash has a limited free API tier. Never commit a real API key.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=knowverse
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=250
